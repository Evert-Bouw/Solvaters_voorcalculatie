    "allowedFrameAncestors": {
      "value": "https://*.afasinsite.nl,https://*.insitetest.afas.online,https://*.insiteaccept.afas.online,https://*.outsitetijdelijk.afas.online,https://*.outsitetest.afas.online,https://*.outsiteaccept.afas.online,https://*.solvatersapps.nl"
